 {
  "scene": "Fabuła – statek RoboBita",
  "id": "story_0",
  "text": "Mój statek rozbił się na Ziemi! Pomóż mi zebrać jego części, a wrócę do domu."
 },
 {
  "scene": "Fabuła – statek RoboBita",
  "id": "story_1",
  "text": "Mamy silnik! Brakuje jeszcze kilku części. Graj dalej!"
 },
 {
  "scene": "Fabuła – statek RoboBita",
  "id": "story_2",
  "text": "Kabina jest na miejscu. Świetnie ci idzie, kapitanie!"
 },
 {
  "scene": "Fabuła – statek RoboBita",
  "id": "story_3",
  "text": "Są już skrzydła! Statek zaczyna wyglądać jak prawdziwa rakieta."
 },
 {
  "scene": "Fabuła – statek RoboBita",
  "id": "story_4",
  "text": "Antena działa! Słyszę sygnał z domu. Jeszcze dwie części!"
 },
 {
  "scene": "Fabuła – statek RoboBita",
  "id": "story_5",
  "text": "Została ostatnia część! Jesteśmy tak blisko startu!"
 },
 {
  "scene": "Fabuła – statek RoboBita",
