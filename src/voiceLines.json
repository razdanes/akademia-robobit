[
 {
  "scene": "Menu główne",
  "id": "menu_hello",
  "text": "Cześć! Jestem RoboBit. Wybierz zabawę!"
 },
 {
  "scene": "Kolorowanki",
  "id": "color_done",
  "text": "Brawo! Świetna robota!"
 },
 {
  "scene": "Paint Junior",
  "id": "paint_done",
  "text": "Piękny rysunek!"
 },
 {
  "scene": "Budujemy komputer",
  "id": "pc_intro",
  "text": "Zbudujmy komputer! Dotknij miejsca, w którym ma być pierwsza część."
 },
 {
  "scene": "Budujemy komputer – opis części",
  "id": "pc_part_case",
  "text": "Obudowa. Obudowa to „dom” komputera. Chroni części przed kurzem i uderzeniami. Ma otwory i wentylatory, żeby w środku płynęło chłodne powietrze."
 },
 {
  "scene": "Budujemy komputer – opis części",
  "id": "pc_part_board",
  "text": "Płyta główna. Płyta główna łączy wszystkie części ze sobą – jak miasto z drogami. Wkręcamy ją w obudowę. Każda część wpina się w inne gniazdo na płycie."
 },
 {
  "scene": "Budujemy komputer – opis części",
  "id": "pc_part_cpu",
  "text": "Procesor (CPU). Procesor to mózg komputera. Liczy i wykonuje polecenia. Wkładamy go w kwadratowe gniazdo na płycie. Uważaj na delikatne złote nóżki!"
 },
 {
  "scene": "Budujemy komputer – opis części",
  "id": "pc_part_cooler",
  "text": "Chłodzenie. Procesor bardzo się grzeje, jak silnik w samochodzie. Chłodzenie z wentylatorem stawiamy na procesorze i wywiewa ciepło. Bez niego komputer by się zawiesił."
 },
 {
  "scene": "Budujemy komputer – opis części",
  "id": "pc_part_ram",
  "text": "Pamięć RAM. RAM to pamięć na chwilę. Trzyma to, co robisz teraz, np. otwartą grę. Wpinamy ją w długie wąskie sloty obok procesora. Po wyłączeniu prądu RAM wszystko zapomina."
 },
 {
  "scene": "Budujemy komputer – opis części",
  "id": "pc_part_ssd",
  "text": "Dysk SSD. Dysk to schowek. Tu na stałe mieszkają system, gry i zdjęcia. Mały dysk M.2 wpinamy w gniazdo na płycie. SSD jest dużo szybszy niż stary dysk z talerzami."
 },
 {
  "scene": "Budujemy komputer – opis części",
  "id": "pc_part_gpu",
  "text": "Karta graficzna. Karta graficzna rysuje obraz na ekranie. Ważna w grach i filmach. Wsuwamy ją w najdłuższe gniazdo PCIe aż kliknie."
 },
 {
  "scene": "Budujemy komputer – opis części",
  "id": "pc_part_psu",
  "text": "Zasilacz. Zasilacz zamienia prąd z gniazdka na bezpieczny prąd dla części. Kable z zasilacza idą do płyty, karty graficznej i dysku. To „serce”, które daje energię."
 },
 {
  "scene": "Budujemy komputer – kolejny krok",
  "id": "pc_ask_board",
  "text": "Teraz: Płyta główna. Gdzie to zamontujemy?"
 },
 {
  "scene": "Budujemy komputer – kolejny krok",
  "id": "pc_ask_cpu",
  "text": "Teraz: Procesor (CPU). Gdzie to zamontujemy?"
 },
 {
  "scene": "Budujemy komputer – kolejny krok",
  "id": "pc_ask_cooler",
  "text": "Teraz: Chłodzenie. Gdzie to zamontujemy?"
 },
 {
  "scene": "Budujemy komputer – kolejny krok",
  "id": "pc_ask_ram",
  "text": "Teraz: Pamięć RAM. Gdzie to zamontujemy?"
 },
 {
  "scene": "Budujemy komputer – kolejny krok",
  "id": "pc_ask_ssd",
  "text": "Teraz: Dysk SSD. Gdzie to zamontujemy?"
 },
 {
  "scene": "Budujemy komputer – kolejny krok",
  "id": "pc_ask_gpu",
  "text": "Teraz: Karta graficzna. Gdzie to zamontujemy?"
 },
 {
  "scene": "Budujemy komputer – kolejny krok",
  "id": "pc_ask_psu",
  "text": "Teraz: Zasilacz. Gdzie to zamontujemy?"
 },
 {
  "scene": "Budujemy komputer – podpowiedź po pomyłce",
  "id": "pc_hint_case",
  "text": "Hmm, to nie tutaj. Podpowiedź: Dotknij dużej ramki dookoła całego komputera."
 },
 {
  "scene": "Budujemy komputer – podpowiedź po pomyłce",
  "id": "pc_hint_board",
  "text": "Hmm, to nie tutaj. Podpowiedź: To duża zielona płyta w środku obudowy."
 },
 {
  "scene": "Budujemy komputer – podpowiedź po pomyłce",
  "id": "pc_hint_cpu",
  "text": "Hmm, to nie tutaj. Podpowiedź: Szukaj małego kwadratu w lewym górnym rogu płyty."
 },
 {
  "scene": "Budujemy komputer – podpowiedź po pomyłce",
  "id": "pc_hint_cooler",
  "text": "Hmm, to nie tutaj. Podpowiedź: Połóż je na procesorze – dotknij jeszcze raz w tym samym miejscu."
 },
 {
  "scene": "Budujemy komputer – podpowiedź po pomyłce",
  "id": "pc_hint_ram",
  "text": "Hmm, to nie tutaj. Podpowiedź: Cztery długie, pionowe sloty obok procesora."
 },
 {
  "scene": "Budujemy komputer – podpowiedź po pomyłce",
  "id": "pc_hint_ssd",
  "text": "Hmm, to nie tutaj. Podpowiedź: Małe, płaskie gniazdo pod procesorem."
 },
 {
  "scene": "Budujemy komputer – podpowiedź po pomyłce",
  "id": "pc_hint_gpu",
  "text": "Hmm, to nie tutaj. Podpowiedź: Najdłuższe poziome gniazdo na dole płyty."
 },
 {
  "scene": "Budujemy komputer – podpowiedź po pomyłce",
  "id": "pc_hint_psu",
  "text": "Hmm, to nie tutaj. Podpowiedź: Prostokąt w prawym dolnym rogu obudowy."
 },
 {
  "scene": "Budujemy komputer",
  "id": "pc_done",
  "text": "Hura! Zbudowałeś komputer! Wszystkie części współpracują."
 },
